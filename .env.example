# Backend (Django)
# OpenRouteService API key. Optional: if empty, the app falls back to
# the public OSRM routing server automatically.
ORS_API_KEY=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend (Vite)
# Base URL of the deployed backend, without a trailing slash.
VITE_API_BASE_URL=http://localhost:8000
